    "plot": {
        "mask": "dbg_raw_en",
        "reg_overlay": [
            // addr, ofs, len, type, name
            //[0x1234, 8, 4, "f", "name"],
            //["pid_i_sq_ki", 20, 4, "f", "sq tgt"]
        ],
        "plots": [
            {
                // "color": ["black", "red", "green"]
                "cfg_reg": "dbg_raw",
                "x_fmt": "H1",
                "label": ["N", "meas_iq", "meas_id", "tgt_iq", "tgt_vq", "tgt_vd", "meas_encoder"],
                "cal": {
                    "sq_err": "_d[1].at(-1) - _d[3].at(-1)", // data1 - data3
                    "sq_err_avg": "                  \
                        let a = 0;                   \
                        for (let i = 0; i < 5; i++)  \
                            a += _d[7].at(-1-i);     \
                        return a / 5;",
                    "sq_err_avg2": "                        \
                        if (_d[7]._f == undefined)          \
                            _d[7]._f = 0;                   \
                        let err = _d[7].at(-1) - _d[7]._f;  \
                        _d[7]._f += err * 0.02;             \
                        return _d[7]._f;"
                },
                "fft": {
                    "sample_rate": 20751.953,
                    "size": 4096
                }
            }, {
                "cfg_reg": "dbg_raw",
                "x_fmt": "H5",
                "label": ["N", "meas_speed", "tgt_speed", "tgt_iq", "meas_encoder", "meas_speed_avg"],
                "cal": {
                    "speed_err2i": "_d[2].at(-1) - _d[1].at(-1)",
                    "speed_err2p": "_d[2].at(-1) - _d[5].at(-1)"
                }
            }, {
                "cfg_reg": "dbg_raw",
                "x_fmt": "H25",
                "label": ["N", "meas_pos", "tgt_pos", "tgt_speed", "tp_vel_out", "meas_speed_avg"],
                "cal": {
                    "pos_err": "_d[2].at(-1) - _d[1].at(-1)"
                }
            }
        ]
    },
    
    "iap": { "reboot": 0x0005, "keep_bl": 0x0006, "batch_pkts": 3 }
